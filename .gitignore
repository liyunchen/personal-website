# ===== 依赖 =====
node_modules/
.venv/
__pycache__/
*.pyc
*.pyo

# ===== 构建产物 =====
# dist 可由 npm run build 重新生成，不入库
portfolio/dist/
dist/

# ===== 敏感信息（严禁提交）=====
# 后台密码哈希（PBKDF2 + salt）
.env
*.env
.env.*
!.env.example

# 登录 token（SHA256 指纹）
tokens.json

# ===== 运行时数据 =====
# 站点内容：由后台管理写入，数据保留在服务器
deploy/server/data/
# 上传的图片文件
deploy/server/uploads/
deploy/shots/
deploy/ui-shots/

# ===== 日志 =====
*.log
api.log

# ===== 编辑器 / 工具临时文件 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ===== WorkBuddy / Playwright 临时产物 =====
.workbuddy-ai/
.playwright-cli/
*.genie
s1-*.yaml